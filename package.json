{
  "name": "components",
  "private": true,
  "version": "0.1.0",
  "description": "Hub em React com 8 projetos filhos, API compartilhada e pacotes comuns num monorepo pnpm.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @components/hub dev",
    "dev:flix": "pnpm --filter @components/flix dev",
    "dev:cadastro": "pnpm --filter @components/cadastro dev",
    "dev:herois": "pnpm --filter @components/herois dev",
    "dev:formularios": "pnpm --filter @components/formularios dev",
    "dev:tarefas": "pnpm --filter @components/tarefas dev",
    "dev:pelada": "pnpm --filter @components/pelada dev",
    "dev:laboratorio": "pnpm --filter @components/laboratorio dev",
    "dev:trilha": "pnpm --filter @components/trilha dev",
    "dev:api": "pnpm --filter @components/api dev",
    "dev:tudo": "pnpm --parallel --filter @components/hub --filter @components/flix --filter @components/cadastro --filter @components/herois --filter @components/formularios --filter @components/tarefas --filter @components/pelada --filter @components/laboratorio --filter @components/trilha --filter @components/api dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @components/hub preview",
        "test": "pnpm -r --workspace-concurrency=2 --no-bail --if-present test",
    "test:e2e": "pnpm --filter @components/formularios test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
